#let octicon-from-path(path) = html.elem("svg", attrs: (
  xmlns: "http://www.w3.org/2000/svg", 
  viewBox: "0 0 16 16",
  height: "16",
  width: "16", 
  class: "octicon"
))[
  #html.elem("path", attrs: (d: path))[]
]

#let octicon(hw: 24, path) = html.elem("svg", attrs: (
  xmlns: "http://www.w3.org/2000/svg", 
  viewBox: "0 0 " + hw + " " + hw,
  height: "" + hw,
  width: "" + hw,
  class: "octicon"
))[
  #html.elem("path", attrs: (d: path))[]
]

